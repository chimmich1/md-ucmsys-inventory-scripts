{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cruise:inventory-observation:v1.1",
  "title": "Universal cruise inventory observation",
  "description": "A time-varying voyage-scoped availability and fare observation. Static cabin masters remain separate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provider", "voyageId", "observedAt", "market", "occupancy", "cabin", "availability", "pricing", "source"],
  "properties": {
    "schemaVersion": {"const": "1.1"},
    "provider": {"type": "string", "minLength": 1},
    "voyageId": {"type": "string", "minLength": 1},
    "observedAt": {"type": "string", "format": "date-time"},
    "packageCode": {"type": "string"},
    "sailDate": {"type": "string", "format": "date"},
    "shipCode": {"type": "string"},
    "configuration": {"type": ["string", "null"]},
    "market": {"type": "object", "additionalProperties": false, "required": ["countryCode", "currency"], "properties": {"countryCode": {"type": "string"}, "currency": {"type": "string"}}},
    "occupancy": {"type": "object", "additionalProperties": false, "required": ["adults", "children"], "properties": {"adults": {"type": "integer", "minimum": 1}, "children": {"type": "integer", "minimum": 0}}},
    "category": {"type": ["object", "null"]},
    "cabin": {"type": "object", "additionalProperties": false, "required": ["cabinNumber"], "properties": {"cabinNumber": {"type": "string"}, "deck": {}, "location": {}, "providerPositionCode": {"type": ["string", "null"]}, "providerPositionName": {"type": ["string", "null"]}, "physicalMasterRef": {"type": ["string", "null"]}, "assignmentMasterRef": {"type": ["string", "null"]}, "raw": {"type": ["object", "null"]}}},
    "availability": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"type": "string"}, "roomsLeft": {"type": ["integer", "null"], "minimum": 0}, "inventoryCompleteForCategory": {"type": ["boolean", "null"]}, "partialReason": {"type": ["string", "null"]}}},
    "pricing": {"type": "object", "additionalProperties": false, "properties": {"scope": {"type": ["string", "null"]}, "fareCode": {"type": ["string", "null"]}, "currency": {"type": ["string", "null"]}, "amount": {"type": ["number", "null"]}, "taxes": {"type": ["number", "null"]}, "total": {"type": ["number", "null"]}, "raw": {"type": ["object", "null"]}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["provider"], "properties": {"provider": {"type": "string"}, "roomLocationUrl": {"type": ["string", "null"], "format": "uri"}, "checkoutEndpoint": {"type": ["string", "null"], "format": "uri"}, "evidenceRef": {"type": ["string", "null"]}}},
    "checkout": {"type": ["object", "null"]}
  }
}
